---
const REWIND = 'M11.5 7 V17 L5 12 Z M19 7 V17 L12.5 12 Z';

// What the call hands back, each with the key it shows: the note is the one thing added, so it is lit.
const restored = [
	{ text: '2 files restored', icon: 'M7 4.5 H13.5 L17.5 8.5 V19.5 H7 Z M13.5 4.5 V8.5 H17.5' },
	{ text: 'Context back to step 2', icon: 'M5 12 A7 7 0 1 0 7.1 7 M5 4.5 V8.5 H9' },
	{ text: '1 note added', icon: 'M7 9 H17 M7 13 H13.5', note: true },
];
---

<section class="call wrap">
	<div class="copy" data-reveal>
		<h2 class="statement">
			<span>One tool call.</span>
			<span>The agent makes it.</span>
		</h2>
		<p class="statement statement--quiet">
			<span>It picks the checkpoint</span>
			<span>and writes the note.</span>
		</p>
	</div>

	<div class="card panel" data-call aria-hidden="true">
		<div class="card-head">
			<i class="key key--note">
				<svg viewBox="0 0 24 24"><path d={REWIND} /></svg>
			</i>
			<h3>Tool call</h3>
			<p>Made by the agent, mid-run.</p>
		</div>
		<p class="bubble">
			<code>rewind(2, <i>"Sleeps don't fix it. The expiry check is wrong."</i>)</code>
		</p>
		<ul>
			{
				restored.map(({ text, icon, note }, i) => (
					<li style={`--i: ${i}`}>
						<i class:list={['key', note ? 'key--note' : 'key--dark']}>
							<svg viewBox="0 0 24 24">
								<path d={icon} />
							</svg>
						</i>
						{text}
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	// The first time the panel scrolls in, the call types itself out, then the results land.
	const TYPE_MS = 22;

	const call = document.querySelector<HTMLElement>('[data-call]');
	if (call && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const chars = letters(call.querySelector('code')!);
		chars.forEach((char) => (char.style.opacity = '0'));
		call.classList.add('is-waiting');

		new IntersectionObserver(
			([entry], observer) => {
				if (!entry.isIntersecting) return;
				observer.disconnect();
				chars.forEach((char, i) => setTimeout(() => type(chars, i), i * TYPE_MS));
				setTimeout(() => call.classList.remove('is-waiting'), chars.length * TYPE_MS + 250);
			},
			{ threshold: 0.6 },
		).observe(call);
	}

	// Wraps every character in its own span. They keep their places, so nothing shifts while typing.
	function letters(root: Element) {
		const chars: HTMLElement[] = [];
		const visit = (parent: Node) => {
			for (const child of [...parent.childNodes]) {
				if (child.nodeType !== Node.TEXT_NODE) {
					visit(child);
					continue;
				}
				const pieces = [...child.textContent!].map((letter) => {
					const char = document.createElement('span');
					char.textContent = letter;
					chars.push(char);
					return char;
				});
				child.replaceWith(...pieces);
			}
		};
		visit(root);
		return chars;
	}

	function type(chars: HTMLElement[], index: number) {
		chars[index - 1]?.classList.remove('is-caret');
		chars[index].style.opacity = '1';
		if (index < chars.length - 1) chars[index].classList.add('is-caret');
	}
</script>

<style>
	.call {
		display: grid;
		align-items: center;
		gap: 2.5rem clamp(2rem, 6vw, 5rem);
		padding-bottom: var(--section);
	}

	.statement--quiet {
		margin-top: 0.9em;
	}

	.panel {
		display: grid;
		align-content: start;
		gap: 1.5rem;
		padding: var(--card-pad);
	}

	/* The call as the agent writes it, on the page's colour like a terminal line. */
	.bubble {
		display: flex;
		gap: 0.7rem;
		padding: 1rem 1.1rem;
		border-radius: 0.75rem;
		background: var(--bg);
		box-shadow: inset 0 0 0 1px var(--line);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.bubble::before {
		content: '\203A';
		color: var(--ghost);
		font-family: var(--font-code);
	}

	code {
		font-family: var(--font-code);
		font-variant-ligatures: none;
	}

	code i {
		font-style: normal;
		color: var(--note);
	}

	code :global(.is-caret) {
		box-shadow: 2px 0 0 var(--ink);
	}

	ul {
		display: grid;
		gap: 0.75rem;
	}

	li {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.9375rem;
		transition:
			opacity 0.5s,
			transform 0.6s var(--ease-out);
		transition-delay: calc(var(--i) * 140ms);
	}

	.is-waiting li {
		opacity: 0;
		transform: translateY(0.4rem);
	}

	li .key {
		--depth: 0.18em;
		flex: none;
		width: 2.25em;
		height: 2.25em;
		border-radius: 0.5em;
	}

	li .key--dark {
		color: var(--ink);
	}

	li .key--note {
		color: var(--bg);
	}

	li svg {
		width: 62%;
		height: 62%;
	}

	li path {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (min-width: 52rem) {
		.call {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
</style>
