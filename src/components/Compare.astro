---
import ContextBars from './ContextBars.astro';
import { sides } from './context';

const kinds = ['undo', 'rewind'] as const;
---

<section class="compare wrap" id="why">
	<div data-reveal>
		<h2 class="statement">
			<span>Agents undo mistakes by hand.</span>
			<span>Now they can rewind.</span>
		</h2>
		<p class="statement statement--quiet">
			<span>Undoing puts the files back.</span>
			<span>The failed attempt stays in the agent&rsquo;s context.</span>
		</p>
	</div>

	<div class="card split">
		{
			kinds.map((kind) => (
				<article class="half">
					<div class="card-head">
						<i class:list={['key', sides[kind].key]} aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={sides[kind].icon} />
							</svg>
						</i>
						<h3>{sides[kind].name}</h3>
						<p>{sides[kind].text}</p>
					</div>
					<ContextBars kind={kind} />
				</article>
			))
		}
		<span class="versus" aria-hidden="true">vs</span>
	</div>
</section>

<style>
	.compare {
		padding-block: var(--section);
	}

	.statement--quiet {
		margin-top: 0.9em;
	}

	/* One card cut in two: the same run, ending two ways. The kept steps line up across the cut. */
	.split {
		position: relative;
		display: grid;
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.half {
		display: grid;
		gap: 1.5rem;
		padding: var(--card-pad);
	}

	.half + .half {
		border-top: 1px solid var(--line);
	}

	.half :global(.cw) {
		height: clamp(14rem, 22vw, 16.5rem);
		border-radius: 0.75rem;
	}

	/* A small dark key sitting on the cut. */
	.versus {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.55rem;
		background: var(--key-dark);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.1),
			0 0.2rem 0 var(--skirt-dark);
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 600;
		translate: -50% -50%;
	}

	@media (min-width: 44rem) {
		.split {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.half + .half {
			border-top: 0;
			border-left: 1px solid var(--line);
		}
	}
</style>
