---
import { bars, KEPT } from './context';

interface Props {
	kind: 'undo' | 'rewind';
	hidden?: boolean;
}

const { kind, hidden = false } = Astro.props;
const list = bars[kind];
// What the model is left holding at the end: everything when undoing by hand, only the kept steps and the note after a rewind.
const count = list.filter((bar) => kind === 'undo' || !bar.wrong).length;
---

<div class:list={['cw', `cw--${kind}`]} data-cw={kind} hidden={hidden} aria-hidden="true">
	<p class="cw__label">
		<span>Context</span>
		<span>{count} messages</span>
	</p>
	<ol>
		{list.map(({ width, wrong, note }, i) => <li class:list={{ wrong, note }} style={`--w: ${width}%; --i: ${i - KEPT}`} />)}
	</ol>
</div>

<script>
	// A window plays its outcome once, the first time it is mostly on screen.
	const watcher = new IntersectionObserver(
		(entries) =>
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add('is-live');
				watcher.unobserve(entry.target);
			}),
		{ threshold: 0.5 },
	);
	document.querySelectorAll('[data-cw]').forEach((screen) => watcher.observe(screen));
</script>

<style is:global>
	/* A context window: one bar per message the model holds. Grey bars are the kept steps, red the failed attempt, yellow the note. */
	.cw {
		--bar: 0.45rem;
		--gap: 0.55rem;
		padding: 1.1rem 1.25rem;
		overflow: hidden;
		background: var(--bg);
		box-shadow: 0 0 0 1px var(--line);
	}

	.cw__label {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.9rem;
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 500;
	}

	.cw__label span + span {
		font-variant-numeric: tabular-nums;
	}

	/* Margins, not gap, so a bar that collapses leaves no hole behind. */
	.cw li {
		width: var(--w);
		height: var(--bar);
		margin-top: var(--gap);
		border-radius: 99px;
		background: rgb(250 250 250 / 0.3);
		transform-origin: left;
	}

	.cw li:first-child {
		margin-top: 0;
	}

	.cw .wrong {
		background: rgb(255 122 102 / 0.75);
	}

	.cw .note {
		background: var(--note);
	}

	/* Without motion each side shows where it ends up: everything, or just the note. */
	.cw--rewind .wrong {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Undo by hand: the failed attempt, then the undoing, pile up and stay. */
		.cw--undo .wrong {
			opacity: 0;
		}

		.cw--undo.is-live .wrong {
			animation: cw-in 0.4s var(--ease-out) calc(var(--i) * 0.12s) both;
		}

		/* Rewind: the same failed attempt piles up, is wiped, and leaves one note behind. */
		.cw--rewind :is(.wrong, .note) {
			display: block;
			height: 0;
			margin-top: 0;
			opacity: 0;
		}

		.cw--rewind.is-live .wrong {
			animation:
				cw-in 0.4s var(--ease-out) calc(var(--i) * 0.12s) both,
				cw-out 0.45s var(--ease-out) 1.9s forwards;
		}

		.cw--rewind.is-live .note {
			animation: cw-in 0.5s var(--ease-out) 2.5s both;
		}
	}

	@keyframes cw-in {
		from {
			height: var(--bar);
			margin-top: var(--gap);
			opacity: 0;
			transform: scaleX(0.3);
		}
		to {
			height: var(--bar);
			margin-top: var(--gap);
			opacity: 1;
			transform: none;
		}
	}

	@keyframes cw-out {
		from {
			height: var(--bar);
			margin-top: var(--gap);
			opacity: 1;
		}
		to {
			height: 0;
			margin-top: 0;
			opacity: 0;
		}
	}
</style>
