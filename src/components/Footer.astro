---
import { site } from '../site';
---

<footer class="footer" data-footer>
	<div class="wrap" data-column>
		<a class="brand" href="/" aria-label={`${site.name}, home`}>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<circle class="ring" cx="12" cy="12" r="9.5"></circle>
				<circle class="dot" cx="12" cy="12" r="3.75"></circle>
			</svg>
			<span>{site.name}</span>
		</a>
		<ul class="links">
			<li><a href={site.repoUrl}>GitHub</a></li>
			<li><a href="https://pi.dev">Pi</a></li>
			<li>{new Date().getFullYear()}</li>
		</ul>
	</div>
	<p class="mark" data-mark aria-hidden="true">{site.name}</p>
</footer>

<script>
	const footer = document.querySelector<HTMLElement>('[data-footer]');
	const column = footer?.querySelector<HTMLElement>('[data-column]');
	const mark = footer?.querySelector<HTMLElement>('[data-mark]');

	if (footer && column && mark) {
		// Whatever the name is, it is sized to span the page's column exactly.
		const fit = () => {
			const letters = document.createRange();
			letters.selectNodeContents(mark);
			const perPixel = letters.getBoundingClientRect().width / parseFloat(getComputedStyle(mark).fontSize);
			const style = getComputedStyle(column);
			const width = column.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
			mark.style.fontSize = `${width / perPixel}px`;
		};
		new ResizeObserver(fit).observe(column);
		document.fonts.ready.then(fit);

		// The pointer carries a light across the wordmark.
		footer.addEventListener('pointermove', (event) => {
			const box = mark.getBoundingClientRect();
			mark.style.setProperty('--x', `${event.clientX - box.left}px`);
			mark.style.setProperty('--y', `${event.clientY - box.top}px`);
		});
	}
</script>

<style>
	.footer {
		overflow: hidden;
		background: var(--well);
		box-shadow: inset 0 1px 0 var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}

	.wrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 2rem;
	}

	/* The nav's mark, smaller and quieter: the page signs off with the same ring and note. */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--ink);
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.ring {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.dot {
		fill: var(--note);
	}

	.links {
		display: flex;
		gap: 1.5rem;
	}

	.links a {
		text-decoration: none;
		transition: color 0.2s;
	}

	@media (hover: hover) {
		.links a:hover {
			color: var(--ink);
		}
	}

	/* The name, standing in the floor: the edge cuts it just above the baseline, and the type fades as it gets there.
	   The font size here is only the starting point; the script above fits it to the column. */
	.mark {
		--x: 50%;
		--y: 50%;
		margin-bottom: -0.25em;
		background:
			radial-gradient(24rem circle at var(--x) var(--y), rgb(200 200 200 / var(--glow)), transparent 70%),
			linear-gradient(#303030 10%, var(--well) 78%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: 38vw;
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: -0.05em;
		text-align: center;
		white-space: nowrap;
		user-select: none;
		transition: --glow 0.6s;
	}

	@media (hover: hover) {
		.footer:hover .mark {
			--glow: 0.9;
		}
	}
</style>
