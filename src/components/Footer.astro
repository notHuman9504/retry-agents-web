---
import { site } from '../site';
---

<footer class="footer" data-footer>
	<div class="wrap">
		<span>{site.name}</span>
		<span>{new Date().getFullYear()}</span>
	</div>
	<p class="mark" data-mark aria-hidden="true">{site.name}</p>
</footer>

<script>
	// The pointer carries a light across the wordmark.
	const footer = document.querySelector<HTMLElement>('[data-footer]');
	const mark = footer?.querySelector<HTMLElement>('[data-mark]');
	if (footer && mark) {
		footer.addEventListener('pointermove', (event) => {
			const box = mark.getBoundingClientRect();
			mark.style.setProperty('--x', `${event.clientX - box.left}px`);
			mark.style.setProperty('--y', `${event.clientY - box.top}px`);
		});
	}
</script>

<style>
	.footer {
		overflow: hidden;
		background: var(--well);
		box-shadow: inset 0 1px 0 var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}

	.wrap {
		display: flex;
		justify-content: space-between;
		padding-block: 2rem;
	}

	/* The name, set as wide as the page and sinking into the floor. */
	.mark {
		--x: 50%;
		--y: 50%;
		margin-bottom: -0.14em;
		background:
			radial-gradient(24rem circle at var(--x) var(--y), rgb(200 200 200 / var(--glow)), transparent 70%),
			linear-gradient(#2a2a2a, var(--well) 88%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: min(15.5vw, 18rem);
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: -0.05em;
		text-align: center;
		white-space: nowrap;
		user-select: none;
		transition: --glow 0.6s;
	}

	@media (hover: hover) {
		.footer:hover .mark {
			--glow: 0.9;
		}
	}
</style>
